AddDefaultCharset utf-8

Options -Indexes

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)$ index.php?q=$1 [L,QSA]

php_value session.use_strict_mode 1
php_value session.auto_start 1

SetEnv nameSite TypeBlog

